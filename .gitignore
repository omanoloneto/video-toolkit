# ----------------------------------------------------------------------------
# Video Toolkit — .gitignore
# ----------------------------------------------------------------------------

# --- Operating system junk ---------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.lnk

# --- IDEs and editors --------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.history/
.atom/
.svn/
.buildlog/

# --- Dart / Flutter ----------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
.flutter-plugins
.flutter-plugins-dependencies
app.*.symbols
app.*.map.json
migrate_working_dir/

# Flutter version managers
.fvm/
.fvmrc.local

# --- macOS (Xcode / CocoaPods) -----------------------------------------------
macos/Pods/
macos/Flutter/ephemeral/
.swiftpm/
**/xcuserdata/
**/DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# --- Windows -----------------------------------------------------------------
windows/flutter/ephemeral/

# --- Linux -------------------------------------------------------------------
linux/flutter/ephemeral/

# --- Logs, temp and local scratch --------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.class
*.pyc
.env
.env.*
!.env.example
TEMP/
tmp/

# --- Media files (keep test fixtures out of the repo) ------------------------
*.mkv
*.mp4
*.m4a
*.aac
*.ac3
*.eac3
*.flac
*.wav
*.opus
*.ogg
*.mka
*.srt
*.ass
*.vtt
